    "\\[fg\\] streamline: DLSS_G present options frame=1 set=0 state=0 mode=0 ",
    "\\[vv\\] frame time: avg="
  ],
  "forbids": [
    "0x887A0005",
    "cmdQ.pacer",
    "Unhandled exception",
    "Panic:",
    "Assertion failed"
  ]
